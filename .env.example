# Nome do app (aparece na barra lateral e no titulo da aba).
# Deixe vazio e o painel mostra so o simbolo.
NEXT_PUBLIC_APP_NAME=

# Banco (Turso). Sem isso, usa ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# URL publica da app (usada no script de tracking e nas URLs de webhook)
NEXT_PUBLIC_URL=http://localhost:3210

# Meta Ads (Marketing API) - token de sistema com ads_read
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Protege as rotas /api/cron/*
CRON_SECRET=troque-isto
